+inline bool Bw2IsTracedIndirectTarget(uint32_t target) {
+    static const std::vector<uint32_t> targets = [] {
+        std::vector<uint32_t> out;
+        if (const char* v = std::getenv("BW2_TRACE_INDIRECT")) {
